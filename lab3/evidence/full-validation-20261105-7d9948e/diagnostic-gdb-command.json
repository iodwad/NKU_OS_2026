{
  "qemu": [
    "qemu-system-riscv64",
    "-machine",
    "virt",
    "-nographic",
    "-bios",
    "default",
    "-device",
    "loader,file=bin/ucore.img,addr=0x80200000",
    "-serial",
    "null",
    "-monitor",
    "none",
    "-no-reboot",
    "-S",
    "-gdb",
    "tcp:127.0.0.1:51957"
  ],
  "gdb": [
    "gdb-multiarch",
    "-nx",
    "-batch",
    "-ex",
    "set architecture riscv:rv64",
    "-ex",
    "target remote 127.0.0.1:51957",
    "-ex",
    "hbreak *0x80005fe8",
    "-ex",
    "hbreak *0x80200000",
    "-ex",
    "continue",
    "-ex",
    "info registers pc ra sp a0 a1 mstatus mepc mcause mtvec stvec satp",
    "-ex",
    "x/8i $pc-12",
    "-ex",
    "x/8i 0x80200000",
    "-ex",
    "x/4gx $sp"
  ],
  "exit": 0
}
