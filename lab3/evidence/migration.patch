 #include <stdio.h>
 
 //lab2 请补充你在lab2中的代码
+
+//lab2 function2-2 2412565
+static free_area_t free_area;
+
+#define free_list (free_area.free_list)
+#define nr_free (free_area.nr_free)
+
+static void
+best_fit_init(void) {
+    list_init(&free_list);
+    nr_free = 0;
+}
+
+static void
+best_fit_init_memmap(struct Page *base, size_t n) {
+    assert(n > 0);
+    for (struct Page *p = base; p != base + n; p ++) {
+        assert(PageReserved(p));
+        p->flags = 0;
+        p->property = 0;
+        set_page_ref(p, 0);
+    }
+    base->property = n;
+    SetPageProperty(base);
+
+    list_entry_t *le = list_next(&free_list);
+    while (le != &free_list && le2page(le, page_link) < base) {
+        le = list_next(le);
+    }
+    list_add_before(le, &base->page_link);
+    nr_free += n;
+}
+
+static struct Page *
+best_fit_alloc_pages(size_t n) {
+    assert(n > 0);
+    if (n > nr_free) {
+        return NULL;
+    }
+
+    struct Page *best = NULL;
+    list_entry_t *le = &free_list;
+    while ((le = list_next(le)) != &free_list) {
+        struct Page *p = le2page(le, page_link);
+        if (p->property >= n &&
+            (best == NULL || p->property < best->property)) {
+            best = p;
+            if (p->property == n) {
+                break;
+            }
+        }
+    }
+    if (best == NULL) {
+        return NULL;
+    }
+
+    size_t block_size = best->property;
+    list_entry_t *prev = list_prev(&best->page_link);
+    list_del(&best->page_link);
+    if (block_size > n) {
+        struct Page *remaining = best + n;
+        remaining->property = block_size - n;
+        SetPageProperty(remaining);
+        list_add(prev, &remaining->page_link);
+    }
+    ClearPageProperty(best);
+    best->property = 0;
+    nr_free -= n;
+    return best;
+}
+
+static void
+best_fit_free_pages(struct Page *base, size_t n) {
+    assert(n > 0);
+    for (struct Page *p = base; p != base + n; p ++) {
+        assert(!PageReserved(p) && !PageProperty(p));
+        p->flags = 0;
+        p->property = 0;
+        set_page_ref(p, 0);
+    }
+    base->property = n;
+    SetPageProperty(base);
+
+    list_entry_t *le = list_next(&free_list);
+    while (le != &free_list && le2page(le, page_link) < base) {
+        le = list_next(le);
+    }
+    list_add_before(le, &base->page_link);
+    nr_free += n;
+
+    while ((le = list_prev(&base->page_link)) != &free_list) {
+        struct Page *previous = le2page(le, page_link);
+        if (previous + previous->property != base) {
+            break;
+        }
+        previous->property += base->property;
+        ClearPageProperty(base);
+        base->property = 0;
+        list_del(&base->page_link);
+        base = previous;
+    }
+
+    while ((le = list_next(&base->page_link)) != &free_list) {
+        struct Page *next = le2page(le, page_link);
+        if (base + base->property != next) {
+            break;
+        }
+        base->property += next->property;
+        ClearPageProperty(next);
+        next->property = 0;
+        list_del(&next->page_link);
+    }
+}
+
+static size_t
+best_fit_nr_free_pages(void) {
+    return nr_free;
+}
 
